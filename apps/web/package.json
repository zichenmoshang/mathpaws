{
  "name": "mathpaws-client",
  "private": true,
  "version": "0.1.0",
  "description": "MathPaws Web 客户端（一期 2D）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc && vite build",
    "build:mock": "tsc && vite build --mode mock",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "visual:check": "node scripts/visual-test.mjs",
    "visual:update": "node scripts/visual-test.mjs --update-snapshots",
    "visual:report": "node scripts/visual-report.mjs",
    "sim:economy": "node scripts/economy-sim.mjs"
  },
  "dependencies": {
    "@mathpaws/paperdoll": "workspace:*",
    "@mathpaws/ui": "workspace:*",
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@vanilla-extract/css": "^1.21.2",
    "@vanilla-extract/dynamic": "^2.1.5",
    "idb": "^8.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^3.0.5",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.5"
  }
}

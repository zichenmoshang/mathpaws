{
  "schema": "paperdoll-manifest-v5-runtime",
  "anchors_version": "anchors-v5-runtime",
  "canvas": 2048,
  "icon_size": 512,
  "format": "webp-lossless-alpha",
  "slots": [
    "body",
    "gear",
    "shoe"
  ],
  "z_order": [
    "body",
    "shoe",
    "gear"
  ],
  "runtime_composite": "body (+ item-hat erase mask when gear.kind=item) -> shoe -> gear; kind=head gear with a seam is relit toward the body neck colour before draw. Layers composite on a 2048 offscreen canvas then downscale once.",
  "target_app_dir": "apps/web/src/assets/paperdoll/ (PaperDoll 组件)",
  "default_look": {
    "body": "default",
    "gear": null,
    "shoe": null
  },
